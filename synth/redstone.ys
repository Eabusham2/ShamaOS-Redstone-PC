# ShamaOS redstone technology mapping.
# The caller prepends read_verilog/hierarchy commands and appends write_json.

proc
flatten
opt
fsm
opt
memory_map
opt
techmap
opt
async2sync
dffunmap
opt

dfflibmap -liberty synth/redstone.lib
# Direct gate-family mapping is functionally equivalent for this redstone
# technology and avoids the expensive liberty optimization pass on the large
# ShamaFS/assembler control cones.
abc -fast -g NAND,NOR
clean -purge
