# ShamaOS redstone technology mapping.
# The caller prepends read_verilog/hierarchy commands and appends write_json.

proc
flatten
opt
fsm
opt
memory_map
opt
techmap
opt
# Retain sequential semantics. Python lowers supported synchronous register
# variants and rejects asynchronous/latch cells instead of changing behavior.
dffunmap
opt

dfflibmap -liberty synth/redstone.lib
# Direct gate-family mapping is functionally equivalent for this redstone
# technology and avoids the expensive liberty optimization pass on the large
# ShamaFS/assembler control cones.
# Portable across Yosys packages. The Python driver adds -fast only when the
# installed command advertises support in `help abc`.
abc -g NAND,NOR
clean -purge
